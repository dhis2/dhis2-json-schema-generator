{
  "type": "object",
  "required": [
    "domain",
    "contentLength",
    "storageStatus"
  ],
  "properties": {
    "access": {
      "$ref": "Access.json",
      "readOnly": true
    },
    "assigned": {
      "type": "boolean",
      "readOnly": true
    },
    "attributeValues": {
      "type": "array",
      "items": {
        "$ref": "AttributeValue.json"
      }
    },
    "code": {
      "type": "string"
    },
    "contentLength": {
      "type": "integer",
      "format": "int64"
    },
    "contentMd5": {
      "type": "string"
    },
    "contentType": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "$ref": "UserDto.json"
    },
    "displayName": {
      "type": "string"
    },
    "domain": {
      "$ref": "FileResourceDomain.json"
    },
    "favorite": {
      "type": "boolean"
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hasMultipleStorageFiles": {
      "type": "boolean"
    },
    "href": {
      "type": "string",
      "readOnly": true
    },
    "id": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "lastUpdatedBy": {
      "$ref": "UserDto.json"
    },
    "name": {
      "type": "string"
    },
    "sharing": {
      "$ref": "Sharing.json"
    },
    "storageStatus": {
      "$ref": "FileResourceStorageStatus.json"
    },
    "translations": {
      "type": "array",
      "items": {
        "$ref": "Translation.json"
      }
    }
  }
}
