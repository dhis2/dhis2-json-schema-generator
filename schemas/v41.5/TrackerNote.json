{
  "type": "object",
  "properties": {
    "createdBy": {
      "$ref": "TrackerUser.json"
    },
    "note": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "k4mk6Uc50K2",
      "description": "A UID for an TrackerNote object  \n(Java name `org.hisp.dhis.webapi.controller.tracker.view.Note`)"
    },
    "storedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "storedBy": {
      "type": "string"
    },
    "value": {
      "type": "string"
    }
  }
}
