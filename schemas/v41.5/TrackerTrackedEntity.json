    },
    "trackedEntityType": {
      "type": "string"
    },
    "updatedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "updatedAtClient": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
