      }
    },
    "createdAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "createdAtClient": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "createdBy": {
      "$ref": "TrackerUser.json"
    },
    "deleted": {
      "type": "boolean"
    },
    "enrollments": {
      "type": "array",
      "items": {
        "$ref": "TrackerEnrollment.json"
      }
    },
    "geometry": {
      "type": "object"
    },
    "inactive": {
      "type": "boolean"
    },
    "orgUnit": {
      "type": "string"
    },
    "potentialDuplicate": {
      "type": "boolean"
    },
    "programOwners": {
      "type": "array",
      "items": {
        "$ref": "TrackerProgramOwner.json"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
