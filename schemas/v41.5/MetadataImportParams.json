{
  "type": "object",
  "required": [
    "flushMode",
    "identifier",
    "importMode",
    "preheatMode",
    "atomicMode",
    "userOverrideMode",
    "importStrategy",
    "importReportMode"
  ],
  "properties": {
    "async": {
      "type": "boolean"
    },
    "atomicMode": {
      "type": "string",
      "enum": [
        "ALL",
        "NONE"
      ]
    },
    "flushMode": {
      "type": "string",
      "enum": [
        "OBJECT",
        "AUTO"
      ]
    },
    "identifier": {
      "type": "string",
      "enum": [
        "UID",
        "CODE"
      ]
    },
    "importMode": {
      "type": "string",
      "enum": [
        "COMMIT",
        "VALIDATE"
      ]
    },
    "importReportMode": {
      "type": "string",
      "enum": [
        "FULL",
        "ERRORS",
        "ERRORS_NOT_OWNER",
        "DEBUG"
      ]
    },
    "importStrategy": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "CREATE_AND_UPDATE",
        "DELETE",
        "SYNC",
        "NEW_AND_UPDATES",
        "NEW",
        "UPDATES",
        "DELETES"
      ]
    },
    "metadataSyncImport": {
      "type": "boolean"
    },
    "overrideUser": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "r87xh9Xn8ON",
      "description": "A UID for an User object  \n(Java name `org.hisp.dhis.user.User`)"
    },
    "preheatMode": {
      "type": "string",
      "enum": [
        "REFERENCE",
        "ALL",
        "NONE"
      ]
    },
    "skipSharing": {
      "type": "boolean"
    },
    "skipTranslation": {
      "type": "boolean"
    },
    "skipValidation": {
      "type": "boolean"
    },
    "user": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "r87xh9Xn8ON",
      "description": "A UID for an User object  \n(Java name `org.hisp.dhis.user.User`)"
    },
    "userOverrideMode": {
      "type": "string",
      "enum": [
        "NONE",
        "CURRENT",
        "SELECTED"
      ]
    }
  }
}
