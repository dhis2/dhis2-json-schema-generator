      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "fV5sz4Ys38O",
      "description": "A UID for an Dashboard object  \n(Java name `org.hisp.dhis.dashboard.Dashboard`)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "EXECUTOR",
        "RECEIVER"
      ]
    },
    "receivers": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "wd5C82cv3p6",
      "description": "A UID for an UserGroup object  \n(Java name `org.hisp.dhis.user.UserGroup`)"
    }
  }
}
