{
  "type": "object",
  "required": [
    "schedulingType",
    "jobStatus",
    "lastExecutedStatus",
    "jobType"
  ],
  "properties": {
    "access": {
      "$ref": "Access.json"
    },
    "attributeValues": {
      "type": "array",
      "items": {
        "$ref": "AttributeValue.json"
      }
    },
    "code": {
      "type": "string"
    },
    "configurable": {
      "type": "boolean"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uid",
          "pattern": "^[0-9a-zA-Z]{11}$",
          "minLength": 11,
          "maxLength": 11,
          "example": "r87xh9Xn8ON"
        }
      },
      "description": "A UID reference to a User  \n(Java name `org.hisp.dhis.user.User`)"
    },
    "cronExpression": {
      "type": "string"
    },
    "delay": {
      "type": "integer",
      "format": "int32"
    },
    "displayName": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "errorCodes": {
      "type": "string"
    },
    "executedBy": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean"
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "href": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "jobParameters": {
      "oneOf": [
        {
          "$ref": "MetadataImportParams.json"
        },
        {
          "$ref": "ImportOptions.json"
        },
        {
          "$ref": "AnalyticsJobParameters.json"
        },
        {
          "$ref": "ContinuousAnalyticsJobParameters.json"
        },
        {
          "$ref": "MonitoringJobParameters.json"
        },
        {
          "$ref": "PredictorJobParameters.json"
        },
        {
          "$ref": "PushAnalysisJobParameters.json"
        },
        {
          "$ref": "HtmlPushAnalyticsJobParameters.json"
        },
        {
          "$ref": "SmsJobParameters.json"
        },
        {
          "$ref": "MetadataSyncJobParameters.json"
        },
        {
          "$ref": "EventProgramsDataSynchronizationJobParameters.json"
        },
        {
          "$ref": "TrackerProgramsDataSynchronizationJobParameters.json"
        },
        {
          "$ref": "DataSynchronizationJobParameters.json"
        },
        {
          "$ref": "DisableInactiveUsersJobParameters.json"
        },
        {
          "$ref": "TrackerTrigramIndexJobParameters.json"
        },
        {
          "$ref": "DataIntegrityJobParameters.json"
        },
        {
          "$ref": "DataIntegrityDetailsJobParameters.json"
        },
        {
          "$ref": "AggregateDataExchangeJobParameters.json"
        },
        {
          "$ref": "SqlViewUpdateParameters.json"
        },
        {
          "$ref": "LockExceptionCleanupJobParameters.json"
        },
        {
          "$ref": "TestJobParameters.json"
        },
        {
          "$ref": "ImportOptions.json"
        },
        {
          "$ref": "GeoJsonImportJobParams.json"
        }
      ]
    },
    "jobStatus": {
      "type": "string",
      "enum": [
        "RUNNING",
        "SCHEDULED",
        "DISABLED",
        "COMPLETED",
        "STOPPED",
        "FAILED",
        "NOT_STARTED"
      ]
    },
    "jobType": {
      "type": "string",
      "enum": [
        "DATA_INTEGRITY",
        "DATA_INTEGRITY_DETAILS",
        "RESOURCE_TABLE",
        "ANALYTICS_TABLE",
        "CONTINUOUS_ANALYTICS_TABLE",
        "DATA_SYNC",
        "TRACKER_PROGRAMS_DATA_SYNC",
        "EVENT_PROGRAMS_DATA_SYNC",
        "META_DATA_SYNC",
        "AGGREGATE_DATA_EXCHANGE",
        "SEND_SCHEDULED_MESSAGE",
        "PROGRAM_NOTIFICATIONS",
        "MONITORING",
        "PUSH_ANALYSIS",
        "HTML_PUSH_ANALYTICS",
        "TRACKER_SEARCH_OPTIMIZATION",
        "PREDICTOR",
        "MATERIALIZED_SQL_VIEW_UPDATE",
        "DISABLE_INACTIVE_USERS",
        "TEST",
        "LOCK_EXCEPTION_CLEANUP",
        "MOCK",
        "SMS_SEND",
        "TRACKER_IMPORT_JOB",
        "TRACKER_IMPORT_NOTIFICATION_JOB",
        "TRACKER_IMPORT_RULE_ENGINE_JOB",
        "IMAGE_PROCESSING",
        "COMPLETE_DATA_SET_REGISTRATION_IMPORT",
        "DATAVALUE_IMPORT_INTERNAL",
        "METADATA_IMPORT",
        "DATAVALUE_IMPORT",
        "GEOJSON_IMPORT",
        "EVENT_IMPORT",
        "ENROLLMENT_IMPORT",
        "TEI_IMPORT",
        "GML_IMPORT",
        "HOUSEKEEPING",
        "DATA_SET_NOTIFICATION",
        "CREDENTIALS_EXPIRY_ALERT",
        "DATA_STATISTICS",
        "FILE_RESOURCE_CLEANUP",
        "ACCOUNT_EXPIRY_ALERT",
        "VALIDATION_RESULTS_NOTIFICATION",
        "REMOVE_USED_OR_EXPIRED_RESERVED_VALUES",
        "SYSTEM_VERSION_UPDATE_CHECK"
      ]
    },
    "lastAlive": {
      "type": "string",
      "format": "date-time"
    },
    "lastExecuted": {
      "type": "string",
      "format": "date-time"
    },
    "lastExecutedStatus": {
      "type": "string",
      "enum": [
        "RUNNING",
        "SCHEDULED",
        "DISABLED",
        "COMPLETED",
        "STOPPED",
        "FAILED",
        "NOT_STARTED"
      ]
    },
    "lastFinished": {
      "type": "string",
      "format": "date-time"
    },
    "lastRuntimeExecution": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "lastUpdatedBy": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uid",
          "pattern": "^[0-9a-zA-Z]{11}$",
          "minLength": 11,
          "maxLength": 11,
          "example": "r87xh9Xn8ON"
        }
      },
      "description": "A UID reference to a User  \n(Java name `org.hisp.dhis.user.User`)"
    },
    "leaderOnlyJob": {
      "type": "boolean"
    },
    "maxDelayedExecutionTime": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string"
    },
    "nextExecutionTime": {
      "type": "string",
      "format": "date-time"
    },
    "queueName": {
      "type": "string"
    },
    "queuePosition": {
      "type": "integer",
      "format": "int32"
    },
    "schedulingType": {
      "type": "string",
      "enum": [
        "CRON",
        "FIXED_DELAY",
        "ONCE_ASAP"
      ]
    },
    "sharing": {
      "$ref": "Sharing.json"
    },
    "translations": {
      "type": "array",
      "items": {
        "$ref": "Translation.json"
      }
    },
    "user": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uid",
          "pattern": "^[0-9a-zA-Z]{11}$",
          "minLength": 11,
          "maxLength": 11,
          "example": "r87xh9Xn8ON"
        }
      },
      "description": "A UID reference to a User  \n(Java name `org.hisp.dhis.user.User`)"
    },
    "userUid": {
      "type": "string"
    }
  }
}
