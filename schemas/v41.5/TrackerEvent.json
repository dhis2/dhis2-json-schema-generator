{
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "assignedUser": {
      "$ref": "TrackerUser.json"
    },
    "attributeCategoryOptions": {
      "type": "string"
    },
    "attributeOptionCombo": {
      "type": "string"
    },
    "completedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "completedBy": {
      "type": "string"
    },
    "createdAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "createdAtClient": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "createdBy": {
      "$ref": "TrackerUser.json"
    },
    "dataValues": {
      "type": "array",
      "items": {
        "$ref": "TrackerDataValue.json"
      }
    },
    "deleted": {
      "type": "boolean"
    },
    "enrollment": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "h9qA2Xb1CV0",
      "description": "A UID for an TrackerEnrollment object  \n(Java name `org.hisp.dhis.webapi.controller.tracker.view.Enrollment`)"
    },
    "event": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "cc1uN0fb9Qi",
      "description": "A UID for an TrackerEvent object  \n(Java name `org.hisp.dhis.webapi.controller.tracker.view.Event`)"
    },
    "followUp": {
      "type": "boolean"
    },
    "followup": {
      "type": "boolean"
    },
    "geometry": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "TrackerNote.json"
      }
    },
    "occurredAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "orgUnit": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "programStage": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "TrackerRelationship.json"
      }
    },
    "scheduledAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "COMPLETED",
        "VISITED",
        "SCHEDULE",
        "OVERDUE",
        "SKIPPED"
      ]
    },
    "storedBy": {
      "type": "string"
    },
    "trackedEntity": {
      "type": "string",
      "format": "uid",
      "pattern": "^[0-9a-zA-Z]{11}$",
      "minLength": 11,
      "maxLength": 11,
      "example": "zg9rM85NF00",
      "description": "A UID for an TrackerTrackedEntity object  \n(Java name `org.hisp.dhis.webapi.controller.tracker.view.TrackedEntity`)"
    },
    "updatedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "updatedAtClient": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "integer",
          "format": "int64"
        }
      ]
    },
    "updatedBy": {
      "$ref": "TrackerUser.json"
    }
  }
}
