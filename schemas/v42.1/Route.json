    },
    "attributeValues": {
      "type": "array",
      "items": {
        "$ref": "AttributeValue.json"
      }
    },
    "auth": {
      "oneOf": [
        {
          "$ref": "HttpBasicAuthScheme.json"
        },
        {
          "$ref": "ApiTokenAuthScheme.json"
        },
        {
          "$ref": "ApiHeadersAuthScheme.json"
        },
        {
          "$ref": "ApiQueryParamsAuthScheme.json"
        },
        {
          "$ref": "OAuth2ClientCredentialsAuthScheme.json"
        }
      ]
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "code": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "createdBy": {
      "$ref": "UserDto.json"
    },
    "description": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    },
    "displayName": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean"
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "href": {
      "type": "string",
      "readOnly": true
    },
    "id": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "lastUpdatedBy": {
      "$ref": "UserDto.json"
    },
    "name": {
      "type": "string"
    },
    "responseTimeoutSeconds": {
      "type": "integer",
      "format": "int32"
    },
    "sharing": {
      "$ref": "Sharing.json"
    },
    "translations": {
      "type": "array",
      "items": {
        "$ref": "Translation.json"
      }
    },
    "url": {
      "type": "string"
    }
