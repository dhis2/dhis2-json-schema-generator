{
  "type": "object",
  "required": [
    "trackerType"
  ],
  "properties": {
    "errorReports": {
      "type": "array",
      "items": {
        "$ref": "TrackerImportError.json"
      }
    },
    "trackerType": {
      "$ref": "TrackerType.json"
    },
    "uid": {
      "type": "string",
