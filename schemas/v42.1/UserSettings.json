{
  "type": "object",
  "required": [
    "userAnalysisDisplayProperty"
  ],
  "properties": {
    "userAnalysisDisplayProperty": {
      "$ref": "DisplayProperty.json"
    },
    "userDbLocale": {
      "type": "string",
      "format": "locale",
      "pattern": "^(?i)(?<lang>[a-z]{2,8})(?:_(?<script>[a-z]{4}))?(?:_(?<country>[a-z]{2}|[0-9]{3}))?(?:_(?<variant>[0-9a-z]{3,8}))?$"
    },
    "userMessageEmailNotification": {
      "type": "boolean"
    },
    "userMessageSmsNotification": {
      "type": "boolean"
    },
    "userStyle": {
      "type": "string"
    },
    "userTrackerDashboardLayout": {
      "type": "string"
    },
    "userUiLocale": {
      "type": "string",
      "format": "locale",
      "pattern": "^(?i)(?<lang>[a-z]{2,8})(?:_(?<script>[a-z]{4}))?(?:_(?<country>[a-z]{2}|[0-9]{3}))?(?:_(?<variant>[0-9a-z]{3,8}))?$"
    }
  }
}
